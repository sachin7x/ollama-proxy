# Copy to .env and fill in the keys you need.
# The server loads this automatically via python-dotenv.
# You only need keys for the providers you actually use.

# OpenAI
OPENAI_API_KEY=sk-...

# Google Gemini
GEMINI_API_KEY=AIza...

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...

# Kimi / Moonshot AI
KIMI_API_KEY=sk-...

# Azure OpenAI
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# xAI / Grok  (https://console.x.ai)
XAI_API_KEY=xai-...

# Groq  (https://console.groq.com)
GROQ_API_KEY=gsk_...

# Mistral AI  (https://console.mistral.ai)
MISTRAL_API_KEY=...

# DeepSeek  (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-...

# Together AI  (https://api.together.ai)
TOGETHER_API_KEY=...

# Perplexity  (https://www.perplexity.ai/settings/api)
PERPLEXITY_API_KEY=pplx-...

# AWS Bedrock (uses standard AWS credential chain)
# Option 1: explicit credentials
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
# Option 2: named profile (from ~/.aws/credentials)
# AWS_PROFILE=my-profile

# ---------------------------------------------------------------------------
# Optional behavior toggles
# ---------------------------------------------------------------------------

# Enable verbose request/response logging
# PROXY_DEBUG=1

# JSON-formatted logs (useful for log aggregators)
# PROXY_LOG_JSON=1

# Add models to /api/tags without editing config files (comma-separated)
# EXTRA_MODELS=openai/gpt-5,gemini/gemini-3-pro

# Path to YAML config file (alternative: --config CLI flag)
# PROXY_CONFIG_FILE=./ollama-proxy.yaml

# ---------------------------------------------------------------------------
# Custom OpenAI-compatible providers — auto-discovered from env vars
# Format: PROVIDERS_<NAME>_API_KEY / PROVIDERS_<NAME>_BASE_URL
# Example: a local vLLM server at port 8000 — call as `vllm/<model-id>`
# ---------------------------------------------------------------------------
# PROVIDERS_VLLM_API_KEY=EMPTY
# PROVIDERS_VLLM_BASE_URL=http://localhost:8000/v1
